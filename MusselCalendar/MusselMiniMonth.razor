<div @ref="element" @attributes="AdditionalAttributes" class="@RootClass">
    <div class="mm-header">
        <span class="mm-title" id="@titleId" aria-live="polite">@month.ToString("Y", FormatCulture)</span>
        <button type="button" class="mm-nav" aria-label="@PreviousText" @onclick="() => ShiftAsync(-1)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 7.4 14 6l-6 6 6 6 1.4-1.4L10.8 12z" /></svg>
        </button>
        <button type="button" class="mm-nav" aria-label="@NextText" @onclick="() => ShiftAsync(1)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 16.6 10 18l6-6-6-6-1.4 1.4 4.6 4.6z" /></svg>
        </button>
    </div>
    <table class="mm-grid" role="grid" aria-labelledby="@titleId">
        <thead>
            <tr>
                @for (var i = 0; i < 7; i++)
                {
                    var weekday = (DayOfWeek)(((int)FirstDayOfWeek + i) % 7);
                    <th scope="col" class="mm-weekday" abbr="@FormatCulture.DateTimeFormat.GetDayName(weekday)">@FormatCulture.DateTimeFormat.GetShortestDayName(weekday)</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var week = 0; week < 6; week++)
            {
                <tr>
                    @for (var i = 0; i < 7; i++)
                    {
                        var day = Start.AddDays((week * 7) + i);
                        <td class="@DayClass(day)" data-date="@IsoDate(day)" tabindex="@TabIndex(day)" aria-selected="@SelectedText(day)" aria-current="@CurrentText(day)" aria-label="@day.ToString("D", FormatCulture)" @onclick="() => SelectAsync(day)"><span>@day.Day</span></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
