@inject NavigationManager Navigation

<div class="mode-switch" role="group" aria-label="Render mode">
    <a class="@ClassOf(!IsWebAssembly)" href="@Link("server")" data-enhance-nav="false">Server</a>
    <a class="@ClassOf(IsWebAssembly)" href="@Link("wasm")" data-enhance-nav="false">WebAssembly</a>
</div>

@code {
    private bool IsWebAssembly => AssignedRenderMode is InteractiveWebAssemblyRenderMode;

    private static string ClassOf(bool active) => active ? "mode active" : "mode";

    private string Link(string mode) => $"render-mode/{mode}?redirect={Uri.EscapeDataString($"/{Navigation.ToBaseRelativePath(Navigation.Uri)}")}";
}
